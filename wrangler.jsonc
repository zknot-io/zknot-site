{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zknot-site",
  "compatibility_date": "2025-09-27",
  "main": "router.js",
  "observability": {
    "enabled": true
  },
  // run_worker_first — without it, Workers Assets serves any path matching a
  // file directly and NEVER invokes router.js, so the WEB-01 security headers
  // in that file applied to almost nothing. Verified live 2026-07-31:
  // /verticals/election-integrity (route name differs from asset name, so the
  // Worker had to run) carried full HSTS + CSP, while /verifiables, /about,
  // /docs and every other auto-matched path carried none.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Custom domains, set in the dashboard; listed here so a deploy matches the remote
  // config instead of prompting to "override" it (2026-10-31).
  "routes": [
    { "pattern": "zknot.io", "custom_domain": true },
    { "pattern": "www.zknot.io", "custom_domain": true }
  ],
  // Listing routes flips these defaults to false; keep them as the dashboard has them.
  "workers_dev": true,
  "preview_urls": true,
  // FallDawn permanent log: access events + AI questions (created 2026-10-31).
  // Schema: migrations/. Query: npx wrangler d1 execute falldawn --remote --command "..."
  "d1_databases": [
    { "binding": "FD_DB", "database_name": "falldawn", "database_id": "4f36e17c-714f-40a3-b6f1-f673fe4815de" }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
